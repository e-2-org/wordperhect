<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^www.wordperhect.net
RewriteRule (.*) http://wordperhect.net/$1 [R=301,L]

RewriteRule tips.asp /perhect.php [L]
RewriteRule perhect[0-9]+\.asp /perhect.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>